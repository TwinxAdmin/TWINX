# Twinx AI Portal — környezeti változók sablon
# Másold .env.local néven és töltsd ki. NE kerüljön verziókezelésbe.

# --- Supabase (1-2. fázis) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Csak szerveroldalon (API route-ok), SOHA ne kliensen:
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (3. fázis) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Bankkártyás vásárlás bekapcsolása (amíg nem "true", a Vásárlás gomb „Hamarosan", és az /api/checkout zárva)
NEXT_PUBLIC_CHECKOUT_ENABLED=

# Számlázz.hu Számla Agent — automatikus számla a kártyás vásárlás után (Számlázz.hu → Beállítások → Számla Agent kulcs)
SZAMLAZZ_AGENT_KEY=
# Számla-beállítások (elhagyhatók; alapértékek a src/lib/szamlazz.ts-ben): ÁFA-kód (AAM = alanyi adómentes, vagy pl. 27),
# tétel megnevezése, fizetési mód, számlaszám-előtag, a vevőnek küldött levél tárgya / szövege, megjegyzés
# INVOICE_VAT_CODE=AAM
# INVOICE_ITEM_NAME=TWINX kreditcsomag
# INVOICE_PAYMENT_METHOD=Bankkártya
# INVOICE_NUMBER_PREFIX=
# INVOICE_EMAIL_SUBJECT=
# INVOICE_EMAIL_TEXT=
# INVOICE_COMMENT=
# INVOICE_MAX_ATTEMPTS=6

# --- AI API-k (4-5. fázis) ---
PERPLEXITY_API_KEY=
GOOGLE_AI_STUDIO_API_KEY=

# --- E-mail (6. fázis, Resend) ---
RESEND_API_KEY=
LEADS_NOTIFY_EMAIL=
# Opcionális feladó (domain hitelesítés után a sajátodra cseréld):
RESEND_FROM=Twinx <onboarding@resend.dev>

# --- Videó pipeline (6.6. fázis) ---
LUMA_API_KEY=
SHOTSTACK_API_KEY=
# Publikus alap-URL a webhookokhoz (lokál: ngrok tunnel URL; éles: a domain):
APP_URL=http://localhost:3000
# Saját titok a videó-webhookok ellenőrzéséhez (bármilyen random string):
VIDEO_WEBHOOK_SECRET=
# Opcionális felülírás:
# LUMA_MODEL=ray-2
# LUMA_DURATION=5s
# SHOTSTACK_ENV=stage   (teszthez 'stage', élesben 'v1')

# Google Analytics 4 — mérőazonosító (CSAK a Vercel Production környezetben állítsd be,
# helyi fejlesztésnél hagyd üresen, hogy ne keveredjen a tesztforgalom az éles adatokba)
NEXT_PUBLIC_GA_ID=

# Brevo — regisztrált felhasználók szinkronja + hírlevél (CSAK szerveroldali, soha ne NEXT_PUBLIC_):
BREVO_API_KEY=
# A listák száma a Brevóban (Contacts → Lists → az ID oszlop):
BREVO_LIST_USERS=
BREVO_LIST_NEWSLETTER=
BREVO_LIST_3D=
# Saját titok a leiratkozás-webhookhoz (a Brevóban: …/api/brevo/webhook?token=<ez>):
BREVO_WEBHOOK_SECRET=

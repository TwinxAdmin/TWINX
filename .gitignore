# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (a titkos .env* NEM kerül gitbe, de a példa fájl igen)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# átszínezett videó-overlay-ek munkakönyvtára (npm run video:overlays)
.cache/

# Levél-előnézet (beágyazott képekkel, generált)
marketing/email/elonezet.html

# Átadási ZIP-ek (generált)
marketing/email/atadas-smartlead/
marketing/email/atadas-brevo/

# Videó-effektek nagy forrásfájljai (a kész klipek a gitben vannak)
assets/video-fx/source/

# 3D-modul mérőpad kimenete (scripts/floorplan3d-meropad.mjs)
/.floorplan3d-meropad/

# 3D-modul: saját generált bútorok jóváhagyás előtt (scripts/floorplan3d-generate-furniture.mjs)
/.floorplan3d-generalt/

# Látványtervező: generált referenciaképek jóváhagyás előtt (scripts/visualization-generate-references.mjs)
/.visualization-referenciak/
# … és a hozzájuk tartozó helyi jóváhagyó rács (a képeket a fenti mappából mutatja)
/design/visualization-referenciak-attekinto.html
